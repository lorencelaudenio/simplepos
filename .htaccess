# Always serve the POS dashboard as the directory index.
DirectoryIndex index.php index.html

# Disable directory listings if mod_autoindex is active.
Options -Indexes

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

<FilesMatch "^(database\.sql|composer\.json|composer\.lock|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
