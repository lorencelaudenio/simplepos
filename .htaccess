# Always serve the POS dashboard as the directory index.
DirectoryIndex index.php index.html

# Disable directory listings if mod_autoindex is active.
Options -Indexes

# Never serve dotfiles or repository metadata (.git, .env, etc.).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]

    # Send old .php URLs to their extensionless equivalents.
    RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE,QSA]

    # Internally map clean URLs back to their PHP files.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

<FilesMatch "^(database\.sql|composer\.json|composer\.lock|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
